        "to": "skillPack"
      },
      {
        "from": "skillSheet",
        "to": "skillPack"
      },
      {
        "from": "scriptTheme",
        "to": "itemSheet"
      },
      {
        "from": "itemNames",
        "to": "itemSheet"
      },
      {
        "from": "itemSheet",
        "to": "itemSplit"
      },
      {
        "from": "itemNames",
        "to": "itemPack"
      },
      {
        "from": "itemSheet",
        "to": "itemPack"
      },
      {
        "from": "scriptTheme",
        "to": "statusSheet"
      },
      {
        "from": "statusNames",
        "to": "statusSheet"
      },
      {
        "from": "statusSheet",
        "to": "statusSplit"
      },
      {
        "from": "statusNames",
        "to": "statusPack"
      },
      {
        "from": "statusSheet",
        "to": "statusPack"
      }
    ]
  }
}
